<div class="banner">
  <h1><%= @list.name %></h1>
</div>

<div class="bookmark-buttons">
  <%= link_to "← Back to all lists", lists_path, class: "back_to" %>
  <%= link_to "add a movie", new_list_bookmark_path(@list), class: "btn-add" %>
</div>

<% if @bookmarks.empty? %>
  <p class="empty">No movies in this list yet.</p>
<% else %>
  <div class="bookmarks">
    <% @bookmarks.each do |bookmark| %>
      <div class="bookmark-card">
        <div class="bookmark-image" style="background-image: url('<%= bookmark.movie.poster_url %>');"></div>

        <div class="bookmark-info">
          <h3>
            <%= bookmark.movie.title %>
            <span class="rating">• <%= bookmark.movie.rating %> <i class="fa-solid fa-star"></i></span>
          </h3>
          <p class="overview"><%= bookmark.movie.overview %></p>

          <div class="bookmark-footer">
            <span class="comment">
              <i class="fa-solid fa-quote-left"></i> <%= bookmark.comment %>
            </span>
            <%= link_to "delete", list_bookmark_path(bookmark),
                  class: "delete",
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
