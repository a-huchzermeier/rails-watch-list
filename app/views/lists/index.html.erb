<div class="banner">
  <h1>My lists</h1>
</div>

<div class="buttons">
  <%= link_to "Add new category", new_list_path, class: "btn-add" %>
</div>

<div class="lists-grid">
  <% @lists.each do |list| %>
    <%= link_to list_path(list), class: "genre",
          style: ("background-image: url('#{list.image_url}');" if list.try(:image_url).present?) do %>
      <span class="genre-name"><%= list.name %></span>
    <% end %>
  <% end %>
</div>
